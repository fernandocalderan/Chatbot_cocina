{
  "version": "flow_clinicas_privadas__osteopatia__intent__embarazo_postparto__v1",
  "router_save_to": "intent",
  "label": "Embarazo o postparto",
  "symptoms": [
    "dolor pélvico",
    "lumbalgia en embarazo",
    "recuperación postparto"
  ],
  "questions": [
    {
      "id": "q1",
      "text": "¿Dónde notas el dolor o la molestia? (zona exacta)"
    },
    {
      "id": "q2",
      "text": "¿Desde cuándo empezó?"
    },
    {
      "id": "q3",
      "text": "En una escala 0–10, ¿qué intensidad tiene ahora?"
    },
    {
      "id": "q4",
      "text": "¿En qué etapa estás (embarazo o postparto) y desde cuándo?"
    }
  ],
  "capture": [
    {
      "key": "zona",
      "type": "text",
      "required": true
    },
    {
      "key": "antiguedad",
      "type": "text",
      "required": true
    },
    {
      "key": "intensidad",
      "type": "number",
      "required": true
    },
    {
      "key": "urgencia",
      "type": "enum",
      "values": [
        "hoy",
        "48h",
        "esta_semana",
        "sin_prisa"
      ],
      "required": false
    }
  ],
  "response": {
    "type": "text",
    "text": "Gracias. Podemos adaptar la sesión a tu etapa. ¿Quieres que te proponga una primera valoración?"
  },
  "config": {
    "subflow": {
      "scope": "osteopatia"
    },
    "problem": {
      "group": "intent",
      "key": "embarazo_postparto",
      "scope": "osteopatia",
      "layout": "v2"
    }
  }
}