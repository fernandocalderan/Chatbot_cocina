{
  "version": "flow_clinicas_privadas__osteopatia__intent__cita_urgente__v1",
  "router_save_to": "intent",
  "label": "Cita urgente",
  "symptoms": [
    "necesito cita pronto",
    "dolor agudo",
    "urgencia"
  ],
  "questions": [
    {
      "id": "q1",
      "text": "¿Dónde notas el dolor o la molestia? (zona exacta)"
    },
    {
      "id": "q2",
      "text": "¿Desde cuándo empezó?"
    },
    {
      "id": "q3",
      "text": "En una escala 0–10, ¿qué intensidad tiene ahora?"
    },
    {
      "id": "q4",
      "text": "¿Qué tan urgente es para ti (hoy/48h/esta semana)?"
    }
  ],
  "capture": [
    {
      "key": "zona",
      "type": "text",
      "required": true
    },
    {
      "key": "antiguedad",
      "type": "text",
      "required": true
    },
    {
      "key": "intensidad",
      "type": "number",
      "required": true
    },
    {
      "key": "urgencia",
      "type": "enum",
      "values": [
        "hoy",
        "48h",
        "esta_semana",
        "sin_prisa"
      ],
      "required": false
    }
  ],
  "response": {
    "type": "text",
    "text": "Entiendo. Haré lo posible por encajar una cita. ¿Quieres que te proponga 2–3 opciones?"
  },
  "config": {
    "subflow": {
      "scope": "osteopatia"
    },
    "problem": {
      "group": "intent",
      "key": "cita_urgente",
      "scope": "osteopatia",
      "layout": "v2"
    }
  }
}