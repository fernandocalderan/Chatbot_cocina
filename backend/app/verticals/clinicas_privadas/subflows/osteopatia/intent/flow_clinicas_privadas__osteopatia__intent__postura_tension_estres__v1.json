{
  "version": "flow_clinicas_privadas__osteopatia__intent__postura_tension_estres__v1",
  "router_save_to": "intent",
  "label": "Postura, tensión o estrés",
  "symptoms": [
    "tensión por estrés",
    "postura en oficina",
    "dolor recurrente"
  ],
  "questions": [
    {
      "id": "q1",
      "text": "¿Dónde notas el dolor o la molestia? (zona exacta)"
    },
    {
      "id": "q2",
      "text": "¿Desde cuándo empezó?"
    },
    {
      "id": "q3",
      "text": "En una escala 0–10, ¿qué intensidad tiene ahora?"
    },
    {
      "id": "q4",
      "text": "¿Notas la tensión más por la mañana o al final del día?"
    }
  ],
  "capture": [
    {
      "key": "zona",
      "type": "text",
      "required": true
    },
    {
      "key": "antiguedad",
      "type": "text",
      "required": true
    },
    {
      "key": "intensidad",
      "type": "number",
      "required": true
    },
    {
      "key": "urgencia",
      "type": "enum",
      "values": [
        "hoy",
        "48h",
        "esta_semana",
        "sin_prisa"
      ],
      "required": false
    }
  ],
  "response": {
    "type": "text",
    "text": "Entendido. Con esto puedo orientarte y sugerirte una primera sesión. ¿Quieres que te proponga horarios?"
  },
  "config": {
    "subflow": {
      "scope": "osteopatia"
    },
    "problem": {
      "group": "intent",
      "key": "postura_tension_estres",
      "scope": "osteopatia",
      "layout": "v2"
    }
  }
}